# Copy to .env (gitignored) and fill in your values:
#   cp .env.example .env
#
# The local dev Grafana provisions two datasources from these values.
# Do NOT commit .env — it is gitignored.

# --- Metrics (Prometheus-compatible endpoint that holds Tempo service graph metrics) ---
# Example shape: https://<host>/select/0/prometheus   (path varies by backend)
METRICS_URL=

# Optional bearer token for the metrics endpoint (uncomment the header lines in
# provisioning/datasources/datasources.yml if you use this).
METRICS_TOKEN=

# --- Traces (Tempo query endpoint) ---
TEMPO_URL=

# Optional bearer token for Tempo.
TEMPO_TOKEN=

# --- Optional Grafana image overrides (defaults: grafana-enterprise 13.0.2) ---
# GRAFANA_IMAGE=grafana
# GRAFANA_VERSION=13.0.2
